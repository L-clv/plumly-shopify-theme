{% comment %} Plumly: Icon features grid — large icons + heading + body for selling features/benefits {% endcomment %}

{%- liquid
  assign cols_desktop = section.settings.columns_desktop
  assign cols_mobile = section.settings.columns_mobile
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="icon-features section spacing-style color-{{ section.settings.color_scheme }}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --icon-features-cols-desktop: {{ cols_desktop }};
    --icon-features-cols-mobile: {{ cols_mobile }};
    --icon-features-gap: {{ section.settings.gap }}px;
    --icon-features-icon-size: {{ section.settings.icon_size }}px;
    --icon-features-align: {{ section.settings.text_align }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="icon-features__heading h3">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="icon-features__subheading">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}

  <div class="icon-features__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'feature' -%}
          <div class="icon-features__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="icon-features__icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 200 }}"
                  alt=""
                  loading="lazy"
                  width="80"
                  height="80"
                >
              </div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="icon-features__item-heading h6">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="icon-features__item-body rte">{{ block.settings.body }}</div>
            {%- endif -%}
            {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
              <a class="icon-features__link" href="{{ block.settings.link_url }}">
                {{ block.settings.link_text | escape }} →
              </a>
            {%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .icon-features {
    text-align: var(--icon-features-align, center);
  }

  .icon-features__heading {
    margin: 0 0 8px;
  }

  .icon-features__subheading {
    margin: 0 auto 32px;
    max-width: 600px;
    opacity: 0.8;
  }

  .icon-features__grid {
    display: grid;
    grid-template-columns: repeat(var(--icon-features-cols-mobile, 1), minmax(0, 1fr));
    gap: var(--icon-features-gap, 32px);
  }

  @media (min-width: 750px) {
    .icon-features__grid {
      grid-template-columns: repeat(var(--icon-features-cols-desktop, 3), minmax(0, 1fr));
    }
  }

  .icon-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .icon-features[style*='--icon-features-align: left'] .icon-features__item {
    align-items: flex-start;
    text-align: start;
  }

  .icon-features__icon {
    width: var(--icon-features-icon-size, 64px);
    height: var(--icon-features-icon-size, 64px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-features__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .icon-features__item-heading {
    margin: 0;
  }

  .icon-features__item-body {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  .icon-features__link {
    margin-top: 4px;
    font-size: 0.9375rem;
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Icon features",
  "class": "section-icon-features",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why customers love us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about how we deliver."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32,
      "max": 128,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid gap",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon / image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature heading"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Describe a benefit, feature, or value prop in one or two sentences.</p>"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon features",
      "blocks": [
        { "type": "feature", "settings": { "heading": "Premium materials" } },
        { "type": "feature", "settings": { "heading": "Sustainable production" } },
        { "type": "feature", "settings": { "heading": "Free shipping & returns" } }
      ]
    }
  ]
}
{% endschema %}
