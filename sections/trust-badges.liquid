{% comment %} Plumly: Trust badges row — icon + label items in a horizontal flex row {% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="trust-badges section spacing-style color-{{ section.settings.color_scheme }}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    --trust-badges-gap: {{ section.settings.gap }}px;
    --trust-badges-icon-size: {{ section.settings.icon_size }}px;
  "
>
  <div
    class="trust-badges__row"
    data-layout="{{ section.settings.layout }}"
  >
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'trust-item' -%}
          <div class="trust-badges__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="trust-badges__icon">
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt=""
                  width="48"
                  height="48"
                  loading="lazy"
                >
              </span>
            {%- endif -%}
            <div class="trust-badges__text">
              {%- if block.settings.heading != blank -%}
                <p class="trust-badges__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="trust-badges__sub">{{ block.settings.subheading | escape }}</p>
              {%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .trust-badges__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--trust-badges-gap, 32px);
  }

  .trust-badges__row[data-layout='space-between'] {
    justify-content: space-between;
  }

  .trust-badges__item {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 1 auto;
    min-width: 0;
  }

  .trust-badges__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--trust-badges-icon-size, 32px);
    height: var(--trust-badges-icon-size, 32px);
    flex-shrink: 0;
  }

  .trust-badges__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .trust-badges__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .trust-badges__heading {
    margin: 0;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .trust-badges__sub {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.3;
    opacity: 0.75;
  }

  @media (max-width: 749px) {
    .trust-badges__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .trust-badges__item {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "class": "section-trust-badges",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "space-between", "label": "Space between" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "trust-item",
      "name": "Trust item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "On orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        {
          "type": "trust-item",
          "settings": {
            "heading": "Free shipping",
            "subheading": "On orders over $50"
          }
        },
        {
          "type": "trust-item",
          "settings": {
            "heading": "30-day returns",
            "subheading": "Hassle-free"
          }
        },
        {
          "type": "trust-item",
          "settings": {
            "heading": "Secure checkout",
            "subheading": "SSL encrypted"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header", "footer", "*"]
  }
}
{% endschema %}
