{% comment %} Plumly: Newsletter discount popup — modal form with localStorage cooldown {% endcomment %}

{%- if section.settings.enable_popup -%}
  <script src="{{ 'newsletter-popup.js' | asset_url }}" type="module" defer></script>

  <newsletter-popup
    data-trigger="{{ section.settings.trigger }}"
    data-delay-seconds="{{ section.settings.delay_seconds }}"
    data-scroll-percent="{{ section.settings.scroll_percent }}"
    data-cooldown-days="{{ section.settings.cooldown_days }}"
  >
    <dialog class="newsletter-popup color-{{ section.settings.color_scheme }}" aria-labelledby="newsletter-popup-heading">
      <button
        type="button"
        class="newsletter-popup__close"
        data-popup-close
        aria-label="Close"
      >×</button>

      {%- if section.settings.image != blank -%}
        <div class="newsletter-popup__media">
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt=""
            loading="lazy"
            width="400"
            height="400"
          >
        </div>
      {%- endif -%}

      <div class="newsletter-popup__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="newsletter-popup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="newsletter-popup-heading" class="newsletter-popup__heading h3">
          {{ section.settings.heading | default: 'Get 10% off' | escape }}
        </h2>

        {%- if section.settings.body != blank -%}
          <div class="newsletter-popup__body rte">{{ section.settings.body }}</div>
        {%- endif -%}

        {% form 'customer', class: 'newsletter-popup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">

          {%- if form.posted_successfully? -%}
            <p class="newsletter-popup__success">
              {{ section.settings.success_message | default: 'Check your inbox for your discount code!' | escape }}
            </p>
          {%- else -%}
            <label for="newsletter-popup-email" class="visually-hidden">Email</label>
            <div class="newsletter-popup__field">
              <input
                type="email"
                id="newsletter-popup-email"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder | default: 'Enter your email' | escape }}"
                required
                autocomplete="email"
              >
              <button type="submit" class="newsletter-popup__submit">
                {{ section.settings.button_label | default: 'Get my code' | escape }}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="newsletter-popup__error">
                {{ form.errors | default_errors }}
              </p>
            {%- endif -%}
          {%- endif -%}
        {% endform %}

        {%- if section.settings.fine_print != blank -%}
          <p class="newsletter-popup__fine-print">{{ section.settings.fine_print | escape }}</p>
        {%- endif -%}
      </div>
    </dialog>
  </newsletter-popup>

  {% stylesheet %}
    .newsletter-popup {
      width: min(540px, calc(100vw - 32px));
      max-width: 100%;
      padding: 0;
      border: none;
      border-radius: 12px;
      background: var(--color-background);
      color: var(--color-foreground);
      box-shadow: 0 24px 64px rgb(0 0 0 / 0.18);
      overflow: hidden;
    }

    .newsletter-popup::backdrop {
      background: rgb(0 0 0 / 0.45);
      backdrop-filter: blur(2px);
    }

    .newsletter-popup__close {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 2;
      width: 36px;
      height: 36px;
      border: none;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.85);
      color: var(--color-foreground);
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
    }

    .newsletter-popup__close:hover {
      background: rgb(255 255 255);
    }

    .newsletter-popup__media img {
      display: block;
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    .newsletter-popup__content {
      padding: 24px 28px 28px;
      text-align: center;
    }

    .newsletter-popup__eyebrow {
      margin: 0 0 4px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.7;
    }

    .newsletter-popup__heading {
      margin: 0 0 8px;
    }

    .newsletter-popup__body {
      margin: 0 0 20px;
      font-size: 0.9375rem;
      line-height: 1.5;
      opacity: 0.85;
    }

    .newsletter-popup__field {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .newsletter-popup__field input[type='email'] {
      flex: 1 1 200px;
      min-width: 0;
      padding: 12px 14px;
      border: 1px solid rgb(from var(--color-foreground) r g b / 0.25);
      border-radius: 8px;
      background: var(--color-background);
      color: var(--color-foreground);
      font-size: 0.9375rem;
    }

    .newsletter-popup__field input[type='email']:focus {
      outline: 2px solid var(--color-foreground);
      outline-offset: 1px;
    }

    .newsletter-popup__submit {
      flex: 0 0 auto;
      padding: 12px 18px;
      border: none;
      border-radius: 8px;
      background: var(--color-foreground);
      color: var(--color-background);
      font-size: 0.9375rem;
      font-weight: 600;
      cursor: pointer;
    }

    .newsletter-popup__submit:hover {
      opacity: 0.92;
    }

    .newsletter-popup__success {
      margin: 0;
      padding: 12px;
      border-radius: 8px;
      background: rgb(from var(--color-foreground) r g b / 0.05);
      font-weight: 500;
    }

    .newsletter-popup__error {
      margin: 8px 0 0;
      color: rgb(204 51 51);
      font-size: 0.875rem;
    }

    .newsletter-popup__fine-print {
      margin: 16px 0 0;
      font-size: 0.75rem;
      opacity: 0.6;
    }

    @media (max-width: 749px) {
      .newsletter-popup__media img {
        height: 160px;
      }

      .newsletter-popup__content {
        padding: 20px 20px 24px;
      }
    }
  {% endstylesheet %}
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "class": "section-newsletter-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable popup",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Trigger"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Trigger",
      "options": [
        { "value": "delay", "label": "Time delay" },
        { "value": "scroll", "label": "Scroll percentage" },
        { "value": "exit", "label": "Exit intent (desktop only)" }
      ],
      "default": "delay"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay (seconds)",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 8,
      "visible_if": "{{ section.settings.trigger == 'delay' }}"
    },
    {
      "type": "range",
      "id": "scroll_percent",
      "label": "Scroll percentage",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.trigger == 'scroll' }}"
    },
    {
      "type": "range",
      "id": "cooldown_days",
      "label": "Re-show cooldown",
      "info": "Days to wait before showing the popup again to a dismissed visitor.",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 14
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Header image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXCLUSIVE OFFER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Sign up for our newsletter and we will email you a discount code for 10% off.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Get my code"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Check your inbox for your discount code!"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "By subscribing, you agree to receive marketing emails. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ],
  "enabled_on": {
    "groups": ["footer", "*"]
  }
}
{% endschema %}
