{% doc %}
  Free-shipping progress bar.

  Reads the threshold from theme settings (`free_shipping_threshold` in store
  currency cents). Re-renders automatically as part of the cart section morph
  on cart:update — no JS needed.

  @example
  {% render 'cart-shipping-progress' %}
{% enddoc %}

{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | default: 0 | times: 1
  if threshold_cents == 0 or settings.show_free_shipping_progress == false
    assign threshold_cents = 0
  endif

  assign current = cart.total_price | default: 0
  assign remaining = threshold_cents | minus: current
  if remaining < 0
    assign remaining = 0
  endif

  assign reached = false
  if threshold_cents > 0 and current >= threshold_cents
    assign reached = true
  endif

  assign percent = 0
  if threshold_cents > 0
    assign percent = current | times: 100 | divided_by: threshold_cents
    if percent > 100
      assign percent = 100
    endif
  endif
-%}

{%- if threshold_cents > 0 -%}
  <div
    class="cart-shipping-progress {% if reached %}cart-shipping-progress--reached{% endif %}"
    role="status"
    aria-live="polite"
    data-cart-shipping-progress
  >
    <p class="cart-shipping-progress__message cart-primary-typography">
      {%- if reached -%}
        {{ settings.free_shipping_reached_message | default: 'You qualify for free shipping!' }}
      {%- else -%}
        {%- assign remaining_money = remaining | money -%}
        {%- assign default_msg = 'You are ' | append: remaining_money | append: ' away from free shipping' -%}
        {{ settings.free_shipping_progress_message
          | default: default_msg
          | replace: '[remaining]', remaining_money
        }}
      {%- endif -%}
    </p>
    <div
      class="cart-shipping-progress__track"
      aria-hidden="true"
    >
      <div
        class="cart-shipping-progress__fill"
        style="width: {{ percent }}%;"
      ></div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .cart-shipping-progress {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    margin-block-end: 1rem;
    border-radius: var(--style-border-radius-cards, 8px);
    background: rgb(from var(--color-foreground) r g b / 0.04);
    font-size: 0.875rem;
  }

  .cart-shipping-progress__message {
    margin: 0;
    font-size: inherit;
    line-height: 1.4;
  }

  .cart-shipping-progress__track {
    position: relative;
    width: 100%;
    height: 4px;
    border-radius: 999px;
    background: rgb(from var(--color-foreground) r g b / 0.12);
    overflow: hidden;
  }

  .cart-shipping-progress__fill {
    height: 100%;
    border-radius: 999px;
    background: var(--color-foreground);
    transition: width 350ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .cart-shipping-progress--reached .cart-shipping-progress__fill {
    background: rgb(34 139 34);
  }

  .cart-shipping-progress--reached .cart-shipping-progress__message {
    font-weight: 600;
  }
{% endstylesheet %}
